# ============================================================
# MarineAI Backend — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o

# AIS Ship Tracking (free tier at aisstream.io)
AISSTREAM_API_KEY=your-aisstream-key-here
# Alternative: MarineTraffic
MARINETRAFFIC_API_KEY=your-marinetraffic-key-here

# Weather APIs
OPENWEATHER_API_KEY=your-openweathermap-key-here
# Open-Meteo is free — no key needed

# Database
DATABASE_URL=postgresql+asyncpg://marineai:password@localhost:5432/marineai_db
DATABASE_URL_SYNC=postgresql://marineai:password@localhost:5432/marineai_db

# Redis
REDIS_URL=redis://localhost:6379

# Security
SECRET_KEY=your-super-secret-jwt-key-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# App Settings
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

# ML Models path
ML_MODELS_DIR=./ml_models/saved

# WebSocket
WS_HEARTBEAT_INTERVAL=30
SHIP_UPDATE_INTERVAL=60
